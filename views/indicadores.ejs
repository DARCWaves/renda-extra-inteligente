<section class="lux-hero compact">
  <span class="lux-kicker">Indicadores econômicos</span>

  <h1>Entenda o que está mexendo no seu bolso.</h1>

  <p>
    Dólar, inflação, Selic, salário mínimo e tributos explicados pelo impacto real na vida de quem trabalha, compra, vende e tenta melhorar de vida.
  </p>

  <p class="muted">
    Status: <span data-live-updated>Atualizando...</span>
  </p>
</section>

<section class="lux-section">
  <div class="section-heading">
    <span>01</span>
    <div>
      <h2>Painel econômico</h2>
      <p>Os números abaixo atualizam automaticamente e servem como leitura prática do cenário.</p>
    </div>
  </div>

  <div class="indicator-grid">
    <% if (indicators && indicators.resumo) { %>
      <% indicators.resumo.forEach(item => { %>
        <a href="/indicador/<%= item.slug %>" class="indicator-card">
          <span><%= item.nome %></span>
          <strong data-indicator-value="<%= item.slug %>"><%= item.valor %></strong>
          <small data-indicator-period="<%= item.slug %>"><%= item.periodo || "Atualizado automaticamente" %></small>
        </a>
      <% }) %>
    <% } %>
  </div>
</section>

<% if (ai) { %>
<section class="lux-section">
  <div class="section-heading">
    <span>02</span>
    <div>
      <h2>Leitura simples do cenário</h2>
      <p>Uma interpretação direta para transformar números em decisão.</p>
    </div>
  </div>

  <article class="lux-card">
    <h3>Diagnóstico</h3>
    <p><%= ai.diagnostico || "Cenário em atualização." %></p>
    <p><%= ai.mensagem || "Acompanhe os dados para tomar decisões melhores." %></p>
  </article>
</section>
<% } %>
