<section class="hero-home">
  <p class="categoria-tag">Conteúdos práticos para melhorar sua vida financeira</p>

  <h2>📚 Aprenda a cuidar do dinheiro sem complicação</h2>

  <p>
    Conteúdos sobre renda extra, controle financeiro, investimentos, trabalho, economia e programação simples para criar oportunidades reais.
  </p>

  <div class="home-actions">
    <a href="/categoria/renda-extra" class="btn-primary">Quero ganhar mais →</a>
    <a href="/categoria/financas" class="btn-secondary">Quero organizar meu dinheiro</a>
  </div>
</section>

<section>
  <h3>🔥 Todos os conteúdos</h3>

  <% if (posts && Array.isArray(posts) && posts.length > 0) { %>
    <% posts.forEach(post => { %>
      <article class="card">
        <% if (post.image) { %>
          <img 
            src="<%= post.image %>" 
            alt="<%= post.imageAlt || post.title %>" 
            class="post-cover" 
            loading="lazy"
            onerror="this.style.display='none';"
          >
        <% } %>
        <div class="categoria-tag">📌 <%= post.category || "financas" %></div>

        <h3><%= post.title || "Conteúdo sem título" %></h3>

        <p>
          <%= post.description || post.seoDescription || "Conteúdo educativo sobre finanças, renda extra e dinheiro." %>
        </p>

        <p class="text-muted">
          Publicado em:
          <%= post.createdAt ? new Date(post.createdAt).toLocaleDateString("pt-BR") : "Data não disponível" %>
        </p>

        <a href="/post/<%= post.slug %>" class="btn-primary">
          Ler conteúdo completo →
        </a>
      </article>
    <% }) %>
  <% } else { %>
    <article class="card">
        <% if (post.image) { %>
          <img 
            src="<%= post.image %>" 
            alt="<%= post.imageAlt || post.title %>" 
            class="post-cover" 
            loading="lazy"
            onerror="this.style.display='none';"
          >
        <% } %>
      <h3>⚠ Nenhum conteúdo encontrado</h3>
      <p>Ainda não há conteúdos disponíveis no momento.</p>
    </article>
  <% } %>
</section>

<section class="ad-box">
  <p>Espaço reservado para anúncio</p>
</section>

<section>
  <h3>📊 Quer entender o cenário?</h3>

  <p>
    Veja como inflação, dólar e juros afetam seu salário, mercado, dívidas e investimentos.
  </p>

  <a href="/indicadores" class="btn-primary">
    Ver indicadores econômicos →
  </a>
</section>
