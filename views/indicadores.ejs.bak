<section class="hero-home compact-hero">
  <span class="eyebrow">
    <span class="ui-icon icon-pulse"></span>
    Indicadores econômicos em linguagem simples
  </span>

  <h2>Entenda o que está mexendo no seu bolso</h2>

  <p>
    Dólar, inflação, Selic, salário mínimo e tributos explicados pelo impacto real na vida de quem trabalha, compra, vende e tenta melhorar de vida.
  </p>

  <p class="text-muted">
    Status: <span data-live-updated>Atualizando...</span>
  </p>
</section>

<section>
  <h3><span class="ui-icon icon-chart"></span> Painel ao vivo</h3>

  <div class="indicator-grid">
    <% if (indicators && indicators.resumo) { %>
      <% indicators.resumo.forEach(item => { %>
        <a href="/indicador/<%= item.slug %>" class="indicator-card">
          <span><%= item.nome %></span>
          <strong data-indicator-value="<%= item.slug %>"><%= item.valor %></strong>
          <small data-indicator-period="<%= item.slug %>"><%= item.periodo || "Atualizado automaticamente" %></small>
        </a>
      <% }) %>
    <% } %>
  </div>
</section>

<% if (ai) { %>
  <section>
    <h3><span class="ui-icon icon-layers"></span> Leitura simples do cenário</h3>

    <div class="card">
      <h3>Diagnóstico</h3>
      <p><%= ai.diagnostico || "Cenário em atualização." %></p>
      <p><%= ai.mensagem || "Acompanhe os dados para tomar decisões melhores." %></p>
    </div>
  </section>
<% } %>

<section>
  <h3><span class="ui-icon icon-wallet"></span> Como usar esses números</h3>

  <div class="shortcut-grid">
    <div class="card">
      <h3>Dólar</h3>
      <p>Ajuda a entender preços de produtos importados, tecnologia, combustível e parte dos alimentos.</p>
    </div>

    <div class="card">
      <h3>Inflação</h3>
      <p>Mostra se seu salário está comprando menos, mesmo quando o valor na conta parece o mesmo.</p>
    </div>

    <div class="card">
      <h3>Selic</h3>
      <p>Afeta juros, cartão, empréstimos, financiamentos e investimentos de renda fixa.</p>
    </div>

    <div class="card">
      <h3>Tributos</h3>
      <p>Mostra quanto dinheiro está sendo arrecadado e ajuda a entender o peso do Estado no bolso.</p>
    </div>
  </div>
</section>
