<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">

  <title><%= title || appName %></title>

  <meta name="description" content="<%= description || 'Estratégias reais para ganhar dinheiro, organizar sua vida financeira e evoluir.' %>">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- FAVICON -->
  <link rel="icon" type="image/png" href="/favicon.png">

  <!-- CSS -->
  <link rel="stylesheet" href="/style.css">

  <% if (adsenseClient) { %>
    <script async 
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= adsenseClient %>"
      crossorigin="anonymous">
    </script>
  <% } %>
</head>

<body>

<header class="header-saas">

  <div class="logo-area">
    <img src="/logo.png" alt="Logo">
    <div class="logo-text">
      <strong>Renda Extra</strong>
      <span>Inteligente</span>
    </div>
  </div>

  <nav class="nav-saas">
    <a href="/">Home</a>
    <a href="/posts">Conteúdos</a>
    <a href="/categoria/renda-extra">Renda Extra</a>
    <a href="/categoria/financas">Finanças</a>
    <a href="/categoria/programacao">Programação</a>
    <a href="/indicadores">Indicadores</a>
    <a href="/ofertas" class="cta-nav">Ofertas</a>
  </nav>

</header>

<main>
  <%- body %>
</main>

<footer class="footer-saas">
  <p>© <%= new Date().getFullYear() %> - <%= appName %></p>
</footer>

</body>
</html>
