<%
  const safePost = post || {};
  const postTitle = safePost.title || "Conteúdo sobre finanças";
  const postDescription = safePost.description || safePost.seoDescription || "Conteúdo educativo, simples e prático.";
  const postCategory = safePost.category || "financas";
  const postContent = safePost.content || "Conteúdo em atualização.";
  const postDate = safePost.createdAt ? new Date(safePost.createdAt).toLocaleDateString("pt-BR") : "Data não disponível";
%>

<section class="lux-hero compact">
  <div class="editorial-badge">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
    Conteúdo Revisado Editorialmente
  </div>

  <span class="lux-kicker"><%= postCategory %></span>

  <h1><%= postTitle %></h1>

  <p><%= postDescription %></p>

  <div class="post-meta-v2">
    <span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      Atualizado em <%= postDate %>
    </span>
    <span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      Redação Renda Extra
    </span>
  </div>

  <div class="lux-actions">
    <a href="/posts" class="btn-dark">Ver outros conteúdos</a>
    <a href="/categoria/<%= postCategory %>" class="btn-gold">Mais sobre este tema →</a>
  </div>
</section>

<% if (safePost.image) { %>
  <section class="post-image-section">
    <img 
      src="<%= safePost.image %>" 
      alt="<%= safePost.imageAlt || postTitle %>" 
      class="post-hero-image"
      loading="lazy"
      onerror="this.closest('section').style.display='none';"
    >
  </section>
<% } %>

<section class="lux-section">
  <div class="section-heading">
    <span>01</span>
    <div>
      <h2>Resumo direto</h2>
      <p>O objetivo deste conteúdo é transformar uma dor real em uma ação prática.</p>
    </div>
  </div>

  <article class="lux-card">
    <p><%= postDescription %></p>
  </article>
</section>

<section class="lux-section">
  <div class="section-heading">
    <span>02</span>
    <div>
      <h2>Conteúdo completo</h2>
      <p>Leia com calma, escolha uma ação e coloque em prática ainda hoje.</p>
    </div>
  </div>

  <article class="lux-card">
    <div class="post-content"><%= postContent %></div>
  </article>
</section>

<% if (typeof affiliates !== 'undefined' && affiliates.length > 0) { %>
  <section class="lux-section">
    <div class="affiliate-disclosure-box">
      <span class="disclosure-tag">Recomendação Editorial</span>
      <p class="disclosure-text">
        Este site é mantido por leitores. Ao comprar através de links em nosso site, podemos receber uma comissão de afiliado sem custo adicional para você.
      </p>
    </div>

    <% const product = affiliates[0]; %>

    <article class="lux-card native-offer-card">
      <div class="offer-flex">
        <% if (product.image) { %>
          <div class="offer-image-wrap">
            <img src="<%= product.image %>" alt="<%= product.title %>" loading="lazy">
          </div>
        <% } %>

        <div class="offer-details">
          <span class="lux-tag"><%= product.category %></span>
          <h3><%= product.title %></h3>
          <p><%= product.description %></p>
          
          <div class="offer-footer">
            <% if (product.price) { %>
              <span class="offer-price"><%= product.price %></span>
            <% } %>
            <a href="/out/<%= product.id %>" class="btn-gold" target="_blank" rel="nofollow noopener">Ver detalhes da oferta</a>
          </div>
        </div>
      </div>
    </article>
  </section>
<% } %>

<section class="lux-section">
  <div class="section-heading">
    <span>04</span>
    <div>
      <h2>Continue evoluindo</h2>
      <p>Escolha outro caminho e continue construindo resultado.</p>
    </div>
  </div>

  <div class="path-grid">
    <a href="/categoria/renda-extra" class="path-card">
      <strong>Renda extra</strong>
      <p>Ideias reais para ganhar mais dinheiro começando pequeno.</p>
    </a>

    <a href="/categoria/financas" class="path-card">
      <strong>Finanças pessoais</strong>
      <p>Controle gastos, dívidas e organize seu dinheiro.</p>
    </a>

    <a href="/categoria/programacao" class="path-card">
      <strong>Programação simples</strong>
      <p>Aprenda lógica e criação de sites sem complicação.</p>
    </a>

    <a href="/indicadores" class="path-card">
      <strong>Indicadores</strong>
      <p>Entenda dólar, inflação e juros no seu bolso.</p>
    </a>
  </div>
</section>

<section class="lux-section">
  <nav class="post-nav-footer">
    <a href="/categoria/<%= post.category %>" class="back-link">
      ← Voltar para <%= post.category.charAt(0).toUpperCase() + post.category.slice(1).replace('-', ' ') %>
    </a>

    <div class="explore-themes">
      <span class="lux-kicker">Explore outros temas</span>
      <div class="theme-tags">
        <a href="/categoria/financas">Finanças</a>
        <a href="/categoria/renda-extra">Renda Extra</a>
        <a href="/categoria/investimentos">Investimentos</a>
        <a href="/categoria/programacao">Programação</a>
        <a href="/categoria/economia">Economia</a>
        <a href="/categoria/trabalho">Trabalho</a>
      </div>
    </div>
  </nav>

  <% if (typeof relatedPosts !== 'undefined' && relatedPosts.length > 0) { %>
    <section class="related-posts-section">
      <div class="section-heading">
        <span>Próximas leituras</span>
        <div>
          <h2>Conteúdos relacionados</h2>
          <p>Continue aprendendo sobre <%= postCategory.replace('-', ' ') %> com estes guias.</p>
        </div>
      </div>

      <div class="related-grid">
        <% relatedPosts.forEach(related => { %>
          <a href="/post/<%= related.slug %>" class="related-card">
            <h4><%= related.title %></h4>
            <p><%= related.description %></p>
          </a>
        <% }) %>
      </div>
    </section>
  <% } %>

  <p class="muted">
    Este conteúdo é educativo. Não é recomendação individual de investimento, compra ou decisão financeira.
  </p>
</section>
