<section class="category-hero">
  <div class="eyebrow">Centro de aprendizado</div>

  <h2><%= (info && info.headline) ? info.headline : 'Conteúdos práticos para evoluir' %></h2>

  <p>
    <%= (info && info.description) ? info.description : 'Aprenda com conteúdos simples, úteis e aplicáveis no dia a dia.' %>
  </p>

  <div class="category-actions">
    <a href="/posts" class="btn-primary">Ver todos os conteúdos</a>
    <a href="/indicadores" class="btn-secondary">Ver indicadores</a>
  </div>
</section>

<section>
  <h3>
    <%= (info && info.title) ? info.title : ('Categoria: ' + categoria) %>
  </h3>

  <% if (!posts || !Array.isArray(posts) || posts.length === 0) { %>
    <article class="post-preview">
      <h4>Nenhum conteúdo encontrado nesta categoria ainda</h4>

      <p>
        Esta categoria existe, mas ainda não possui conteúdos suficientes publicados.
        Enquanto isso, explore todos os conteúdos disponíveis.
      </p>

      <a href="/posts" class="btn-primary">Ver todos os conteúdos</a>
    </article>
  <% } else { %>
    <div class="post-grid">
      <% posts.forEach(post => { %>
        <article class="post-preview">
          <div class="categoria-tag">
            <%= post.category || categoria %>
          </div>

          <h4><%= post.title || 'Conteúdo educativo' %></h4>

          <p>
            <%= post.description || post.seoDescription || 'Conteúdo prático para melhorar sua vida financeira.' %>
          </p>

          <a href="/post/<%= post.slug %>" class="btn-primary">
            Ler conteúdo completo →
          </a>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section>
  <h3>Continue evoluindo</h3>

  <p>
    O melhor resultado vem quando você combina conhecimento, prática e constância.
    Escolha um conteúdo, aplique uma ideia e volte para aprender o próximo passo.
  </p>

  <a href="/posts" class="btn-primary">Explorar mais conteúdos</a>
</section>
