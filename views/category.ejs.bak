<%
  const safeInfo = info || {};
  const safePosts = Array.isArray(posts) ? posts : [];
  const safeCategoria = categoria || "financas";
  const titleLabel = safeInfo.title || "Conteúdos";
  const headline = safeInfo.headline || "Conteúdos práticos para sua vida";
  const desc = safeInfo.description || "Conteúdos simples, práticos e diretos.";
%>

<section class="lux-hero compact">
  <span class="lux-kicker"><%= titleLabel %></span>

  <h1><%= headline %></h1>

  <p><%= desc %></p>

  <div class="lux-actions">
    <a href="/posts" class="btn-dark">Ver todos os conteúdos</a>
    <a href="/indicadores" class="btn-gold">Entender indicadores →</a>
  </div>
</section>

<section class="lux-section">
  <div class="section-heading">
    <span>01</span>
    <div>
      <h2>Conteúdos de <%= titleLabel %></h2>
      <p>Artigos simples, diretos e criados para resolver dores reais.</p>
    </div>
  </div>

  <% if (!safePosts.length) { %>
    <article class="lux-card">
      <span class="lux-tag"><%= safeCategoria %></span>
      <h3>Nenhum conteúdo encontrado ainda</h3>
      <p>
        Esta categoria ainda não recebeu conteúdos suficientes. A produção automática continuará criando novos materiais em ciclos.
      </p>
      <a href="/posts" class="text-link">Ver todos os conteúdos →</a>
    </article>
  <% } else { %>
    <div class="content-grid">
      <% safePosts.forEach(post => { %>
        <article class="lux-card post-card">
          <span class="lux-tag"><%= post.category || safeCategoria %></span>

          <h3><%= post.title || "Conteúdo educativo" %></h3>

          <p>
            <%= post.description || post.seoDescription || "Conteúdo simples, direto e prático para melhorar sua vida." %>
          </p>

          <% if (post.slug) { %>
            <a href="/post/<%= post.slug %>" class="text-link">Ler conteúdo completo →</a>
          <% } else { %>
            <a href="/posts" class="text-link">Ver conteúdos →</a>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="lux-section">
  <div class="section-heading">
    <span>02</span>
    <div>
      <h2>Continue explorando</h2>
      <p>O crescimento vem quando você conecta conhecimento, ação e consistência.</p>
    </div>
  </div>

  <div class="path-grid">
    <a href="/categoria/financas" class="path-card">
      <strong>Finanças pessoais</strong>
      <p>Controle gastos, dívidas e organize seu dinheiro.</p>
    </a>

    <a href="/categoria/renda-extra" class="path-card">
      <strong>Renda extra</strong>
      <p>Ideias reais para ganhar mais dinheiro começando pequeno.</p>
    </a>

    <a href="/categoria/programacao" class="path-card">
      <strong>Programação simples</strong>
      <p>Aprenda lógica, sites e tecnologia sem complicação.</p>
    </a>

    <a href="/categoria/investimentos" class="path-card">
      <strong>Investimentos</strong>
      <p>Comece com pouco, clareza e responsabilidade.</p>
    </a>
  </div>
</section>
