<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">

  <title><%= title || appName %></title>

  <meta name="description" content="<%= description || 'Finanças, renda extra e estratégia real para crescer na vida.' %>">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- FAVICON (GOOGLE) -->
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="shortcut icon" href="/favicon.png">

  <meta name="theme-color" content="#0b0b0f">

  <!-- ESTILO -->
  <link rel="stylesheet" href="/style.css">

  <% if (adsenseClient) { %>
    <script async 
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= adsenseClient %>"
      crossorigin="anonymous">
    </script>
  <% } %>
</head>

<body>

<header class="header-premium">

  <div class="logo-box">
    <img src="/logo.png" alt="Renda Extra Inteligente">
    <span>Renda Extra</span>
  </div>

  <nav>
    <a href="/">Home</a>
    <a href="/posts">Conteúdos</a>
    <a href="/categoria/renda-extra">Renda Extra</a>
    <a href="/categoria/financas">Finanças</a>
    <a href="/categoria/programacao">Programação</a>
    <a href="/indicadores">Indicadores</a>
<a href="/ofertas">Ofertas</a>
  </nav>

</header>

<main>
  <%- body %>
</main>

<footer>
  <p>© <%= new Date().getFullYear() %> - <%= appName %></p>
</footer>

</body>
</html>
